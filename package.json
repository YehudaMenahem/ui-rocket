{
  "name": "ui-rocket",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "A React component library with 90s DOS-game aesthetic",
  "author": "Yehuda",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ui-rocket/site dev",
    "start": "pnpm --filter @ui-rocket/site dev",
    "build": "pnpm --recursive --stream build",
    "typecheck": "pnpm --recursive --stream typecheck",
    "lint": "pnpm --recursive --stream lint",
    "test": "pnpm --recursive --stream test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.0.0"
}
