{
  "name": "ui-rocket",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "A React component library with 90s DOS-game aesthetic",
  "author": "Yehuda Menahem",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ui-rocket/site dev",
    "start": "pnpm --filter @ui-rocket/site dev",
    "build": "pnpm --filter @ui-rocket/rocket build && pnpm --filter @ui-rocket/site build",
    "typecheck": "pnpm --recursive --stream typecheck",
    "lint": "pnpm --recursive --stream lint",
    "test": "pnpm --recursive --stream test",
    "build:rocket": "pnpm --filter @ui-rocket/rocket build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "size": "pnpm --filter @ui-rocket/rocket build && size-limit"
  },
  "size-limit": [
    {
      "name": "@ui-rocket/rocket ESM (gzip)",
      "path": "packages/rocket/dist/index.js",
      "gzip": true,
      "limit": "12.5 kB"
    }
  ],
  "devDependencies": {
    "@size-limit/file": "^11.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.0.0"
}
